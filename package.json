{
  "name": "hugobentivegna",
  "private": true,
  "version": "0.1.0",
  "description": "Hugo Bentivegna's portfolio: a slide-based Next.js site built on its own design system.",
  "scripts": {
    "tokens": "node src/design-system/tokens/build.mjs",
    "dev": "pnpm tokens && next dev",
    "build": "pnpm tokens && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm tokens && next typegen && tsc --noEmit",
    "test": "pnpm tokens && vitest run",
    "storybook": "pnpm tokens && storybook dev -p 6006",
    "build-storybook": "pnpm tokens && storybook build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "style-dictionary": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.7"
}
